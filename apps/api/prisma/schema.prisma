// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id                   String                @id @default(uuid())
  roleId               Int
  role                 Role                  @relation(fields: [roleId], references: [id])
  firstName            String
  lastName             String
  email                String                @unique
  provider             String                @default("email")
  passwordHash         String?
  isActive             Boolean               @default(false)
  emailVerified        Boolean               @default(false)
  lastLoggedIn         DateTime?
  createdById          String?
  createdBy            User?                 @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins        User[]                @relation("AdminCreatedBy")
  otpCode              String?
  otpPurpose           String?
  otpExpiresAt         DateTime?
  score                Float                 @default(0)
  institution          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  courses              Course[]
  enrollments          StudentCourse[]
  payments             Payment[]
  quizAttempts         QuizAttempt[]
  moduleProgress       ModuleProgress[]
  lessonProgress       LessonProgress[]
  certificates         Certificate[]
  createdChallenges    Challenge[]
  challengeSubmissions ChallengeSubmission[]
  challengeProgress    ChallengeProgress[]

  @@index([institution])
  @@index([score])
}

enum CourseStatus {
  draft
  published
  archived
}

enum CourseAccessType {
  FREE
  PAID_COURSE
  PAID_CERTIFICATE
}

enum PaymentType {
  COURSE_ACCESS
  CERTIFICATE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum BlockType {
  text
  image
  code
  playground
}

model Course {
  id               String          @id @default(uuid())
  title            String
  slug             String          @unique
  description      String?
  thumbnailKey     String?
  status           CourseStatus    @default(draft)
  accessType       CourseAccessType @default(FREE)
  price            Float?
  certificatePrice Float?
  createdById      String
  createdBy        User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  modules          Module[]
  quiz             Quiz?
  enrollments      StudentCourse[]
  certificates     Certificate[]
  payments         Payment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([createdById])
}

enum EnrollmentStatus {
  PENDING
  ENROLLED
  PASSED
}

model StudentCourse {
  id         String           @id @default(uuid())
  studentId  String
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ENROLLED)
  enrolledAt DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, courseId])
}

model ModuleProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, moduleId])
}

model Module {
  id         String           @id @default(uuid())
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int
  lessons    Lesson[]
  quiz       Quiz?
  progress   ModuleProgress[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([courseId, orderIndex])
}

model Quiz {
  id           String        @id @default(uuid())
  moduleId     String?       @unique
  module       Module?       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId     String?       @unique
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId     String?       @unique
  lesson       Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  passingScore Int
  maxAttempts  Int           @default(3)
  questions    Question[]
  attempts     QuizAttempt[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum AttemptStatus {
  pass
  fail
}

model QuizAttempt {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score     Int
  status    AttemptStatus
  answers   QuizAttemptAnswer[]
  createdAt DateTime            @default(now())

  @@index([userId, quizId])
}

// One row per option the student ticked.
// questionId and optionId are deliberately NOT relations: quiz content cascades on
// delete, and we do not want an admin editing a quiz to erase past attempts.
model QuizAttemptAnswer {
  id         String      @id @default(uuid())
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  optionId   String
  createdAt  DateTime    @default(now())

  @@unique([attemptId, questionId, optionId])
  @@index([attemptId])
}

model Question {
  id         String           @id @default(uuid())
  quizId     String
  quiz       Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text       String
  orderIndex Int
  options    QuestionOption[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([quizId, orderIndex])
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean
  orderIndex Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([questionId, orderIndex])
}

model Certificate {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Lesson {
  id         String           @id @default(uuid())
  moduleId   String
  module     Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int
  blocks     LessonBlock[]
  quiz       Quiz?
  progress   LessonProgress[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([moduleId, orderIndex])
}

model LessonBlock {
  id             String    @id @default(uuid())
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type           BlockType
  content        String?
  storageKey     String?
  caption        String?
  language       String?
  linkedGroupId  String?   // NEW: UUID for grouping related code blocks
  playgroundData Json?
  orderIndex     Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([lessonId, orderIndex])
}

model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model Payment {
  id                     String        @id @default(uuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId               String
  course                 Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type                   PaymentType
  status                 PaymentStatus @default(PENDING)
  amount                 Float
  currency               String        @default("RWF")
  xentripayRefId         String        @unique
  phoneNumber            String?
  paymentProvider        String?
  paymentMethod          String?
  paymentReference       String?
  paidAt                 DateTime?
  expiresAt              DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([userId, courseId])
  @@index([status])
}

// ─── Challenges ───────────────────────────────────────────────────────────────

enum Difficulty {
  easy
  medium
  hard
}

enum ChallengeStatus {
  draft
  published
}

enum SubmissionStatus {
  accepted
  wrong_answer
  time_limit_exceeded
  runtime_error
  compile_error
}

model Challenge {
  id             String          @id @default(uuid())
  number         Int             @unique @default(autoincrement())
  title          String
  slug           String          @unique
  description    String          // Rich text HTML
  difficulty     Difficulty
  status         ChallengeStatus @default(draft)
  // starterCode: { python: "...", java: "...", javascript: "...", c: "...", cpp: "...", go: "..." }
  starterCode    Json
  // functionParams: [{ name: string, type: string }] — LeetCode-style function signature
  functionParams Json?
  // returnType: e.g. "int", "string", "int[]", "void"
  returnType     String?
  timeLimit      Int             @default(5) // seconds per test case
  orderIndex     Int             @default(0)
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  createdBy   User                  @relation(fields: [createdById], references: [id])
  testCases   ChallengeTestCase[]
  submissions ChallengeSubmission[]
  progress    ChallengeProgress[]

  @@index([status])
}

model ChallengeTestCase {
  id             String    @id @default(uuid())
  challengeId    String
  input          String
  expectedOutput String
  isHidden       Boolean   @default(true)
  orderIndex     Int

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, orderIndex])
}

model ChallengeSubmission {
  id          String           @id @default(uuid())
  userId      String
  challengeId String
  language    String
  code        String
  status      SubmissionStatus
  testsPassed Int
  totalTests  Int
  submittedAt DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, challengeId])
}

model ChallengeProgress {
  id          String   @id @default(uuid())
  userId      String
  challengeId String
  completedAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}
