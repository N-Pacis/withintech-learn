// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id             String           @id @default(uuid())
  roleId         Int
  role           Role             @relation(fields: [roleId], references: [id])
  firstName      String
  lastName       String
  email          String           @unique
  passwordHash   String
  isActive       Boolean          @default(false)
  emailVerified  Boolean          @default(false)
  lastLoggedIn   DateTime?
  createdById    String?
  createdBy      User?            @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins  User[]           @relation("AdminCreatedBy")
  otpCode        String?
  otpPurpose     String?
  otpExpiresAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  courses        Course[]
  enrollments    StudentCourse[]
  quizAttempts   QuizAttempt[]
  moduleProgress ModuleProgress[]
  certificates     Certificate[]
  showcaseProjects ShowcaseProject[] @relation("ShowcaseAuthor")
  showcaseLikes    ShowcaseLike[]    @relation("ShowcaseLikes")
}

enum CourseStatus {
  draft
  published
  archived
}

enum BlockType {
  text
  image
  code
}

model Course {
  id           String          @id @default(uuid())
  title        String
  slug         String          @unique
  description  String?
  thumbnailKey String?
  status       CourseStatus    @default(draft)
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  modules      Module[]
  quiz         Quiz?
  enrollments  StudentCourse[]
  certificates Certificate[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
  @@index([createdById])
}

enum EnrollmentStatus {
  PENDING
  ENROLLED
  PASSED
}

model StudentCourse {
  id         String           @id @default(uuid())
  studentId  String
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ENROLLED)
  enrolledAt DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, courseId])
}

model ModuleProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, moduleId])
}

model Module {
  id         String           @id @default(uuid())
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int
  blocks     ModuleBlock[]
  quiz       Quiz?
  progress   ModuleProgress[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([courseId, orderIndex])
}

model ModuleBlock {
  id         String    @id @default(uuid())
  moduleId   String
  module     Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type       BlockType
  content    String?
  storageKey String?
  caption    String?
  language   String?
  orderIndex Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([moduleId, orderIndex])
}

model Quiz {
  id           String        @id @default(uuid())
  moduleId     String?       @unique
  module       Module?       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId     String?       @unique
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  passingScore Int
  maxAttempts  Int           @default(3)
  questions    Question[]
  attempts     QuizAttempt[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum AttemptStatus {
  pass
  fail
}

model QuizAttempt {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score     Int
  status    AttemptStatus
  createdAt DateTime      @default(now())

  @@index([userId, quizId])
}

model Question {
  id         String           @id @default(uuid())
  quizId     String
  quiz       Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text       String
  orderIndex Int
  options    QuestionOption[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([quizId, orderIndex])
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean
  orderIndex Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([questionId, orderIndex])
}

model Certificate {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, courseId])
}

// ─── Showcase ─────────────────────────────────────────────────────────────────

enum ShowcaseStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum ChallengeCategory {
  Agriculture
  Healthcare
  Education
  Water
  Energy
  Finance
  Transport
  Environment
  Employment
  Digital
}

model ShowcaseProject {
  id                 String                @id @default(uuid())
  authorId           String
  author             User                  @relation("ShowcaseAuthor", fields: [authorId], references: [id])
  title              String
  description        String?
  problemStatement   String
  githubUrl          String?
  demoUrl            String?
  thumbnailKey       String?
  aiUsageDescription String?
  status             ShowcaseStatus        @default(PENDING)
  rejectionReason    String?
  featuredAt         DateTime?
  categories         ShowcaseCategoryTag[]
  images             ShowcaseImage[]
  likes              ShowcaseLike[]
  techTags           ShowcaseTechTag[]
  aiTools            ShowcaseAITool[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([authorId])
  @@index([status])
}

model ShowcaseCategoryTag {
  projectId String
  category  ChallengeCategory
  project   ShowcaseProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, category])
  @@index([category])
}

model ShowcaseImage {
  id         String          @id @default(uuid())
  projectId  String
  project    ShowcaseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storageKey String
  orderIndex Int
  createdAt  DateTime        @default(now())

  @@unique([projectId, orderIndex])
  @@index([projectId])
}

model ShowcaseTechTag {
  projectId String
  name      String
  project   ShowcaseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, name])
  @@index([name])
}

model ShowcaseAITool {
  projectId String
  name      String
  project   ShowcaseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, name])
}

model ShowcaseLike {
  projectId String
  userId    String
  project   ShowcaseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User            @relation("ShowcaseLikes", fields: [userId], references: [id])
  createdAt DateTime        @default(now())

  @@id([projectId, userId])
}
